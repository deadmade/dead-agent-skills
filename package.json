{
  "name": "dead-agent-skills",
  "version": "0.6.0",
  "private": true,
  "description": "Personal skills, flows and integrations for Claude Code and Codex.",
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "test": "node scripts/check-repo.mjs && node --test --experimental-test-coverage --test-coverage-include=\"installer/**\" --test-coverage-exclude=\"installer/**/*.test.ts\" --test-coverage-lines=79 \"installer/**/*.test.ts\" && node --test \"scripts/*.test.mjs\" \"plugins/default/hooks/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/check-harnesses.mjs && tsc",
    "build:harnesses": "node scripts/build-harnesses.mjs",
    "build:codex": "node scripts/build-codex.mjs",
    "check:codex": "node scripts/check-codex.mjs",
    "check:harnesses": "node scripts/check-harnesses.mjs"
  },
  "bin": {
    "dead-agent-skills": "installer/install.js",
    "dead-claude-skills": "installer/install.js"
  },
  "files": [
    "installer/**/*.js",
    "!installer/**/*.test.js",
    "installer/assets/",
    "catalog/plugins.json",
    ".claude-plugin/marketplace.json",
    "plugins/*/.claude-plugin/plugin.json",
    "plugins/*/*/.claude-plugin/plugin.json",
    "plugins/*/*/*/.claude-plugin/plugin.json",
    "portable/",
    ".agents/plugins/marketplace.json"
  ],
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
