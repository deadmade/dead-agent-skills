{
  "mcpServers": {
    "serena": {
      "command": "${user_config.serenaPath}",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "False",
        "--open-web-dashboard",
        "False",
        "--add-mode",
        "no-memories"
      ]
    }
  }
}
