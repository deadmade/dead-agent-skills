{
  "description": "graphify's soft-nudge PreToolUse guards (same as `graphify install`): add context pointing at graphify-out/ when a graph exists; always exit 0.",
  "hooks": [
    {
      "event": "tool.starting",
      "tools": [
        "shell",
        "search"
      ],
      "command": [
        "graphify",
        "hook-guard",
        "search"
      ],
      "required": false,
      "background": false
    },
    {
      "event": "tool.starting",
      "tools": [
        "file.read",
        "file.find"
      ],
      "command": [
        "graphify",
        "hook-guard",
        "read"
      ],
      "required": false,
      "background": false
    }
  ]
}
