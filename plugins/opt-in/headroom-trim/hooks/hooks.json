{
  "description": "Starts headroom-trim's local trim server at session start and posts every tool result to it. HEADROOM_TRIM=off stops this session's launcher.",
  "hooks": [
    {
      "event": "session.started",
      "script": "hooks/launch.mjs",
      "args": ["47811"],
      "required": false,
      "background": false
    },
    {
      "event": "tool.completed",
      "tools": ["*"],
      "http": "http://127.0.0.1:47811/hook",
      "timeoutSeconds": 5,
      "required": false,
      "background": false
    }
  ]
}
