{
  "description": "Default bundle: global instructions, the Night City theme and mod, desktop notifications, Context7, plus agent-review as a dependency.",
  "author": {
    "name": "deadmade",
    "url": "https://github.com/deadmade"
  },
  "dependencies": [
    {
      "name": "agent-review",
      "targets": ["claude-code"]
    }
  ],
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "themes": [
    {
      "name": "night-city",
      "palette": "themes/palette.json"
    }
  ],
  "instructions": "rules.md",
  "extensions": [
    {
      "kind": "ui-mod",
      "entry": "hooks/register.tsx",
      "copy": ["hooks/register.tsx", "hooks/background.ts", "hooks/words.ts", "assets"]
    }
  ],
  "hooks": "hooks/hooks.json"
}
