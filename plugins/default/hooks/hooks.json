{
  "description": "Standing coding rules at session start and desktop notifications when a turn ends or the agent waits for you; shared by every harness that supports these events.",
  "hooks": [
    {
      "event": "session.started",
      "handler": "rules",
      "required": true,
      "background": false,
      "timeoutSeconds": 10
    },
    {
      "event": "turn.finished",
      "handler": "notifications",
      "required": true,
      "background": true,
      "timeoutSeconds": 10
    },
    {
      "event": "permission.requested",
      "handler": "notifications",
      "required": false,
      "background": true,
      "timeoutSeconds": 10
    },
    {
      "event": "question.asked",
      "handler": "notifications",
      "required": false,
      "background": true,
      "timeoutSeconds": 10
    },
    {
      "event": "notification.received",
      "handler": "notifications",
      "required": false,
      "background": true,
      "timeoutSeconds": 10
    }
  ]
}
