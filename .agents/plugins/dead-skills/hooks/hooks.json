{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/runtime/run.mjs\" --harness codex --event session.started --handler rules",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/runtime/run.mjs\" --harness codex --event turn.finished --handler notifications",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/runtime/run.mjs\" --harness codex --event permission.requested --handler notifications",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/runtime/run.mjs\" --harness codex --event question.asked --handler notifications",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
