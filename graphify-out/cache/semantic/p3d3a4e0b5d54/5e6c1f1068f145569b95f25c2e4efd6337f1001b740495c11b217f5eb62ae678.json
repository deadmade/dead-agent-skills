{"nodes": [{"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_skill", "label": "Subagent-Driven Development skill", "file_type": "document", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_sdd_ledger", "label": "SDD progress ledger (progress.md)", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L108-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conversation memory does not survive compaction; controllers that lost their place re-dispatched entire completed task sequences, the most expensive failure observed."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_rulings_not_stalls", "label": "Rulings, not stalls", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L19-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wrong ruling costs visible, undoable rework; a session parked on a question costs the human partner's whole day."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_four_stop_conditions", "label": "Four stop conditions", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L27-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only irreversible/destructive ops, security-sensitive actions, external side effects (merge, push, publish), or a hopelessly broken plan justify stopping."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_continuous_execution", "label": "Continuous execution", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check-in prompts and progress summaries waste the partner's time; they asked for the plan to be executed."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_fresh_subagent_per_task", "label": "Fresh subagent per task", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L8-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolated, precisely crafted context keeps subagents focused and preserves the controller's context for coordination."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_model_selection", "label": "Model Selection", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L139-L174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the least powerful capable model; turn count beats token price, so mid-tier is the floor for reviewers; always specify the model explicitly."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_sdd_workspace_script", "label": "scripts/sdd-workspace", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L113-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_task_brief_script", "label": "scripts/task-brief", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L202-L213", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_review_package_script", "label": "scripts/review-package", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L241", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_record_base_sha", "label": "Record BASE before dispatch (never HEAD~1)", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L199-L200", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HEAD~1 silently drops all but the last commit of a multi-commit task."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_hand_artifacts_as_files", "label": "Hand artifacts over as files", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L182-L184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything pasted into a dispatch or printed back stays resident in the controller's context and is re-read every turn."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_no_subagents_contract", "label": "No-subagents contract", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L223-L228", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every worker-spawned reviewer duplicated the controller's task review, a full extra review seat per task."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_implementer_status_contract", "label": "Implementer status contract (DONE / DONE_WITH_CONCERNS / NEEDS_CONTEXT / BLOCKED)", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L239-L245", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_task_review_gate", "label": "Per-task review gate (spec compliance + task quality)", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L251-L257", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_global_constraints_lens", "label": "Global constraints block as reviewer attention lens", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L271-L277", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_no_prejudging_findings", "label": "Do not pre-judge findings for the reviewer", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L282-L287", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phrases like 'do not flag' or 'at most Minor' are pre-judging, usually to spare the controller a review loop."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_bounded_waiting", "label": "Bounded waiting on dispatched subagents", "file_type": "rationale", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L186-L195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded 5-10 minute stretches keep a long wait's efficiency while ensuring a stuck or lost child is noticed within minutes."}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_task_completion_line", "label": "Task completion ledger line", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L304-L316", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_executing_plans", "label": "superpowers:executing-plans", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L48-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_using_git_worktrees", "label": "superpowers:using-git-worktrees", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L103-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_finishing_a_development_branch", "label": "superpowers:finishing-a-development-branch", "file_type": "concept", "source_file": "plugins/flows/packs/superpowers/skills/subagent-driven-development/SKILL.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_superpowers_skills_subagent_driven_development_skill_spec_binding_authority", "label": "Spec as binding authority over plan", "file_type": "rationale", "source_file": 