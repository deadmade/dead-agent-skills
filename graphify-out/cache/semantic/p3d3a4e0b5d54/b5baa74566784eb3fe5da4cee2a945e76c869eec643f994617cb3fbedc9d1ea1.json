{"nodes": [{"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_msbuild_property_handling", "label": "MSBuild Property Handling (CPM conversion)", "file_type": "document", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_directory_packages_props", "label": "Directory.Packages.props", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_directory_build_props", "label": "Directory.Build.props", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_import_order_guidance", "label": "Import order: Directory.Build.props before Directory.Packages.props", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A property kept as Version=\"$(Prop)\" in Directory.Packages.props must be defined in a file MSBuild evaluates earlier; Directory.Build.props qualifies because it is imported first."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_inline_vs_keep_property_decision", "label": "Inline vs keep version-property decision", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Properties used only for versioning may be inlined as literals or kept as references; properties used for other purposes are never removed, their resolved value is used instead."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_out_of_scope_property_options", "label": "Out-of-scope property safe options", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop before editing; expand scope, use resolved literal, or keep the reference only if evaluated earlier. Skipping the central PackageVersion would leave NU1008 or NU1010 after CPM is enabled."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_convert_to_cpm_references_msbuild_property_handling_obsolete_property_cleanup", "label": "Obsolete property cleanup with two-check verification", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/convert-to-cpm/references/msbuild-property-handling.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remove inlined property definitions only with zero remaining references; verify both $(PropertyName) uses and the <PropertyName> element are gone before final validation."}], "edges": [{"source": "plugins_opt_in_implementation_csharp_skil