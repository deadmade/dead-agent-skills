{"nodes": [{"id": "plugins_opt_in_implementation_csharp_skills_library_including_generated_files_skill_including_generated_files", "label": "Including Generated Files Into Your Build (skill)", "file_type": "document", "source_file": "plugins/opt-in/implementation/csharp-skills/library/including-generated-files/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_including_generated_files_skill_evaluation_phase", "label": "MSBuild Evaluation Phase", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/including-generated-files/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Globs outside targets expand during evaluation, before generated files exist, so they miss build-time artifacts."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_including_generated_files_skill_execution_phase", "label": "MSBuild Execution Phase", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/including-generated-files/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_including_generated_files_skill_intermediateoutputpath", "label": "$(IntermediateOutputPath) for generated files", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/including-generated-files/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intermediate path can be redirected (shared output dirs, CI), so hardcoding obj\\ breaks."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_including_generated_files_skill_filewrites", "label": "FileWrites registration for clean", "file_type": "conce