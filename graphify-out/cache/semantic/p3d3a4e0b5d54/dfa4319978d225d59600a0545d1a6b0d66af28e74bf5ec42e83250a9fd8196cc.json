{"nodes": [{"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns", "label": "SQL Query Patterns Reference", "file_type": "document", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_cte_materialization", "label": "CTE Materialization (MATERIALIZED / NOT MATERIALIZED)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Force materialization when referenced multiple times or to create an optimization fence."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_window_functions", "label": "Window Functions", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_gaps_and_islands", "label": "Gaps and Islands", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_lateral_top_n", "label": "LATERAL Top-N Per Group", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Much faster than window functions given an index on (customer_id, created_at DESC)."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_recursive_cte", "label": "Recursive CTE Tree Traversal", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L160", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_upsert_on_conflict", "label": "UPSERT (INSERT ON CONFLICT)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not use xmax = 0 to detect insert vs update; use OLD/NEW RETURNING on PG18+."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_returning_old_new_pg18", "label": "OLD/NEW in RETURNING (PG18+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_merge_statement", "label": "MERGE (PG15+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L253", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use MERGE over INSERT ON CONFLICT when actions depend on conditions, source is a table/query, or DELETE is needed."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_json_table", "label": "JSON_TABLE (PG17+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L287", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_bulk_operations", "label": "Bulk Operations", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L305", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch deletes with LIMIT to avoid long locks."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_jsonb_queries", "label": "JSONB Queries and Modification", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L342", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_date_bin", "label": "date_bin() (PG14+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L402", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_skip_locked_queue", "label": "SKIP LOCKED Queue Processing", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L450", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets multiple workers claim queue rows without blocking each other."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_deadlock_prevention", "label": "Deadlock Prevention (Consistent Lock Order)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L468", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_transaction_discipline", "label": "Transaction Discipline (statement/idle/transaction timeouts)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L481", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep transactions short; move external calls outside the transaction boundary."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_n_plus_one_elimination", "label": "N+1 Query Elimination with ANY", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L496", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_not_in_null_antipattern", "label": "NOT IN with NULLs Anti-Pattern", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L531", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT IN returns no rows if any subquery value is NULL; use NOT EXISTS."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_implicit_cast_antipattern", "label": "Implicit Casts in WHERE Anti-Pattern", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L543", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Casting a column prevents index use; rewrite as a range."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_keyset_pagination", "label": "Keyset Pagination (vs OFFSET)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L557", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFFSET scans and discards rows."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_select_star_antipattern", "label": "SELECT * Anti-Pattern", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/query-patterns.md", "source_location": "L528", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks when columns change and prevents index-only scans."}], "edges": [{"source": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns", "target": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_query_patterns_cte_materialization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-