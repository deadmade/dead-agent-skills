ll_granular_cascaded_types", "label": "Keep cascaded types granular", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every NotifyChangedAsync re-renders all subscribers regardless of which property changed."}], "edges": [{"source": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_coordinate_components", "target": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_cascadingvalue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_coordinate_components", "target": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_cascadingvaluesource", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_coordinate_components", "target": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_notifychangedasync_update_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_coordinate_components", "target": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_scoped_state_se