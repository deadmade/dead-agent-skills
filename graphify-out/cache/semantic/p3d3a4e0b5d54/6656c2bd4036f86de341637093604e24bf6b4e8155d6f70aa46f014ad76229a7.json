{"nodes": [{"id": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_coordinate_components", "label": "coordinate-components skill", "file_type": "document", "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_cascadingvalue", "label": "CascadingValue component (subtree state)", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_cascadingvaluesource", "label": "CascadingValueSource<T> registered via DI", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_notifychangedasync_update_protocol", "label": "NotifyChangedAsync update protocol", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/coordinate-components/SKILL.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only mechanism that re-renders all [CascadingParameter] subscribers; never substitute NavigationManager.Refresh or page reloads."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_coordinate_components_skill_scoped_state_service", "label": "Scoped state service with Action OnChange (CartState)", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/c