{"nodes": [{"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication", "label": "Logical Replication & Migrations Reference", "file_type": "document", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_logical_replication", "label": "Logical Replication", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replicates specific tables, works across major versions, allows writable subscribers - unlike physical replication."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_publication", "label": "Publication (CREATE PUBLICATION)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer explicit table lists over FOR ALL TABLES so the set can change later."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_subscription", "label": "Subscription (CREATE SUBSCRIPTION)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_replica_identity", "label": "Replica Identity", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it UPDATE and DELETE fail on the publisher; FULL sends entire old row."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_replication_slot", "label": "Replication Slot", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One permanent slot per subscription plus temporary per-table slots during initial sync."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_decoder_plugins", "label": "Logical Decoding Plugins (pgoutput, wal2json)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_wal_level_logical", "label": "wal_level = logical", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing requires restart; managed platforms may control it via UI/API."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_subscription_rel_state_codes", "label": "pg_subscription_rel State Codes", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L359", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_replication_lag_monitoring", "label": "Replication Lag Monitoring", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L295", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_ddl_not_replicated", "label": "Schema Changes During Replication (DDL Not Replicated)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L391", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add columns on subscriber first so the publisher never sends a column the subscriber lacks."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_live_migration_pattern", "label": "Live Migration Pattern (Minimal Downtime)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L436", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defer index creation until after initial copy to speed sync; stop writes, drain lag, sync sequences, switch connections."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_sequence_synchronization", "label": "Sequence Synchronization", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L451", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logical replication does not replicate sequences, so they must be advanced on target before cutover."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_row_count_verification", "label": "Row Count Verification", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L470", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_wal_accumulation_troubleshooting", "label": "Replication Slot WAL Accumulation", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L524", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_idle_replication_slot_timeout", "label": "idle_replication_slot_timeout (PG18+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/logical-replication.md", "source_location": "L585", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-invalidates inactive slots to prevent unbounded WAL accumulation."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_logical_replication_publish_generated_columns", "label": "publish_generated_columns (P