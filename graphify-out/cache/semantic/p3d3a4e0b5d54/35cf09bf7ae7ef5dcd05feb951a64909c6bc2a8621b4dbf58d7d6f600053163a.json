{"nodes": [{"id": "plugins_default_readme", "label": "dead-skills default bundle README", "file_type": "document", "source_file": "plugins/default/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_dead_skills_default_bundle", "label": "dead-skills default bundle", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One bundle installed on every machine: global rules, Context7, Night City and notifications, depending on the core plugins (claude-code-setup, claude-md-management, security-guidance, claude-security). It no longer depends on superpowers, ponytail or code-review; those are packs inside flows so their rules/bootstrap only apply under conductors. Night City, Context7 and notify were separate plugins until 0.3.0."}, {"id": "plugins_default_readme_global_rules", "label": "Global rules (rules.md injected at session start)", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh installs get the rules via the start-of-session hook rather than a second global instruction block; unrelated global instructions stay untouched."}, {"id": "plugins_default_readme_context7", "label": "Context7 library docs MCP", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_night_city_theme", "label": "Night City theme", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toned-down synthwave house look (dusk indigo, lavender, dusty pink, peach, teal) shared by tui-review, notifications and the installer. Users must pick it in /theme because Claude Code does not let a plugin select a custom theme. Palette derived from ccthemes' Cyberpunk Neon (MIT) and retuned."}, {"id": "plugins_default_readme_osc11_terminal_background", "label": "OSC 11 terminal background sync", "file_type": "rationale", "source_file": "plugins/default/README.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminal background is set to the theme's indigo so empty space matches; reset on exit or theme change; if Claude is killed run printf '\\033]111\\007'."}, {"id": "plugins_default_readme_spinner_words_status_reactions", "label": "Night City spinner words and status-line reactions (FLATLINE / JACKED OUT)", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_ccstatusline_config", "label": "Night City ccstatusline Powerline config", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs a Nerd Font; installer writes it under the ccstatusline toggle and replaces the stock config earlier versions wrote."}, {"id": "plugins_default_readme_syntax_highlighting_disabled", "label": "syntaxHighlightingDisabled + CLAUDE_CODE_TMUX_TRUECOLOR", "file_type": "rationale", "source_file": "plugins/default/README.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Code highlights with a fixed Monokai palette and ignores theme diff colours while highlighting is on (anthropics/claude-code#57036); turning it off lets diffs use Night City mint/coral. Truecolor in tmux avoids indigos turning grey in 256-colour mode."}, {"id": "plugins_default_readme_ccthemes_cyberpunk_neon", "label": "ccthemes Cyberpunk Neon theme (livlign/ccthemes, MIT)", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_onibi_mascot", "label": "Onibi mascot (pixel-art netrunner)", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original 64x64 pixel art whose cybereye is an eight-point spark, a nod to Claude rather than Anthropic's logo; also the notification icon. Drawn by scripts/draw-mascot.mjs; PNGs must not be hand-edited."}, {"id": "plugins_default_readme_draw_mascot_script", "label": "scripts/draw-mascot.mjs", "file_type": "code", "source_file": "plugins/default/README.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_wcag_contrast", "label": "WCAG contrast check (>= 4.5:1)", "file_type": "rationale", "source_file": "plugins/default/README.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_notifications", "label": "Desktop notifications", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Popup on turn.finished, permission.requested and question.asked so the user can work elsewhere; stays quiet when the tmux pane is focused (needs focus-events on), when Windows Terminal is foreground, and for subagents/Stop-hook continuations/headless runs. No macOS support."}, {"id": "plugins_default_readme_notification_delivery", "label": "Notification delivery (busctl/notify-send on Linux, WinRT toast via PowerShell on Windows)", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Talking to the notification daemon directly avoids tmux allow-passthrough; hook runs async so slow PowerShell start does not block the turn; Claude's text passes as an argument/env var, never as script source."}, {"id": "plugins_default_readme_neutral_hook_events", "label": "Neutral hook events (hooks/hooks.json)", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hooks are declared in agent-neutral events (session.started, turn.finished, permission.requested, question.asked, notification.received); each distribution maps them to its agent's events and drops the rest, reporting missing optional events only at build time. Small adapters decode input and encode context; no transcript parsing."}, {"id": "plugins_default_readme_palette_json", "label": "themes/palette.json Night City palette", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single palette source; each distribution generates its agent's theme format plus a setup-night-city skill."}, {"id": "plugins_default_readme_setup_night_city_skill", "label": "setup-night-city skill", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L127", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_default_readme_build_harnesses", "label": "npm run build:harnesses", "file_type": "concept", "source_file": "plugins/default/README.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "plugins_default_readme_dead_skills_default_bundle", "target": "plugins_default_readme_global_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme_dead_skills_default_bundle", "target": "plugins_default_readme_context7", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme_dead_skills_default_bundle", "target": "plugins_default_readme_notifications", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme_dead_skills_default_bundle", "target": "plugins_default_readme_night_city_theme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme", "target": "plugins_default_readme_dead_skills_default_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme_night_city_theme", "target": "plugins_default_readme_osc11_terminal_background", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme_night_city_theme", "target": "plugins_default_readme_spinner_words_status_reactions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/default/README.md", "source_location": null, "weight": 1.0}, {"source": "plugins_default_readme_night_city_theme", "target": "plugins_default_readme_ccstatusline_config", "