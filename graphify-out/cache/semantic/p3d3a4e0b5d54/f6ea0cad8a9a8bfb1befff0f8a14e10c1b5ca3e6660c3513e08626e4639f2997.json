{"nodes": [{"id": "plugins_flows_skills_writing_references_copyedit", "label": "Copyedit a document (procedure)", "file_type": "document", "source_file": "plugins/flows/skills/writing/references/copyedit.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_skills_writing_references_copyedit_copyedit_procedure", "label": "Copyedit procedure (save, edit, check)", "file_type": "concept", "source_file": "plugins/flows/skills/writing/references/copyedit.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fresh editor who was not in the conversation revises the document; the edit goes through only when code finds nothing checkable lost; commits nothing so it works on any branch and inside other flows."}, {"id": "plugins_flows_skills_writing_references_copyedit_run_folder", "label": "Copyedit run folder (saved.md / edited.txt)", "file_type": "concept", "source_file": "plugins/flows/skills/writing/references/copyedit.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emptied first so nothing from an earlier run is mistaken for this one's."}, {"id": "plugins_flows_skills_writing_references_copyedit_copy_editor_subagent", "label": "Fresh copy-editor subagent (general-purpose, opus)", "file_type": "concept", "source_file": "plugins/flows/skills/writing/references/copyedit.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a .txt file because subagents may not be allowed to write Markdown files."}, {"id": "plugins_flows_skills_writing_references_copyedit_preservation_rules", "label": "Copyedit preservation rules (facts, headings, code, links, requirements)", "file_type": "rationale", "source_file": "plugins/flows/skills/writing/references/copyedit.md", "source_location": "L33", "sou