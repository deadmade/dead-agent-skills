{"nodes": [{"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_chapter", "label": "Chapter 1 - Coding Styles and Idioms", "file_type": "document", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_borrowing_over_cloning", "label": "Borrowing over cloning", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Borrow (&T) instead of clone for performance; clone only for Arc/Rc, snapshots, caching, or APIs requiring owned data."}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_copy_trait_pass_by_value", "label": "Copy trait / pass by value (<=24 bytes)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small plain-data types whose fields are all Copy can be passed by value."}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_never_copy_and_iterator", "label": "Never implement both Copy and Iterator", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copying an iterator and advancing one copy silently leaves the other unchanged; core::range types (Rust 1.96) implement IntoIterator so they can be Copy."}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_let_else_pattern", "label": "let-else for Option/Result unpacking", "file_type": "concept", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_avoid_unwrap_outside_tests", "label": "Avoid unwrap/expect outside tests", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_prevent_early_allocation", "label": "Prevent early allocation (_else variants)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_iterator_vs_for", "label": "Iterators vs for loops", "file_type": "concept", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "for loops for early exits and side effects; iterators for transforming/composing collections; iterators are lazy."}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_comments_context_not_clutter", "label": "Comments: context, not clutter", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comments explain why, not what or how; prefer splitting long functions over narrative comments."}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_todos_as_issues", "label": "TODOs tracked as issues", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_use_declaration_ordering", "label": "Use declaration ordering (std, external, workspace, super, crate)", "file_type": "concept", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_when_to_extract_a_function", "label": "When to extract a function", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/rust-skills/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extraction adds indirection; a wrong abstraction is harder to remove than duplication. Extract only shared knowledge, 3+ occurrences, names that add meaning."}, {"id": "plugins_opt_in_implementation_rust_skills_skills_rust_best_practices_references_chapter_01_rule_of_three", "label": "Rule of Three (Don Roberts / Fowler's Refactoring)", "file_type": "concept", "source_file": "plugins/opt-in/implemen