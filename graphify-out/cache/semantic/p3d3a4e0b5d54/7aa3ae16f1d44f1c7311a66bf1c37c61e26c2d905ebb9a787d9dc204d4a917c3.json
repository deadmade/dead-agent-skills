{"nodes": [{"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_brutal_brutal", "label": "Brutal theme", "file_type": "document", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/brutal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editorial committed theme: raw engineered sheet of 3px rules, boxed cells and solid fills; not a dark hacker page, a decorated zine or a sticker sheet of offset shadows."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_brutal_shared_rule_cells", "label": "Shared-rule boxed cells", "file_type": "rationale", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/brutal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neighbouring cells share one 3px rule via negative margins; a doubled 6px seam reads as a mistake."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_brutal_acid_yellow_fill", "label": "Acid-yellow fill-only accent", "file_type": "rationale", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/brutal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The yellow is a fill, never type, rule or ring; always under ink, under 5% of a screen; focus takes deep olive."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_brutal_font_libre_franklin", "label": "Libre Franklin (typeface)", "file_type": "concept", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/brutal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "plugins_opt_in_hallmark_skills_hallmark_references_themes_brutal_brutal", "target": "plugins_opt_in_hallmark_skills_hallmark_references_themes_brutal_shared_rule_cells", "rel