{"nodes": [{"id": "plugins_shared_graphify_skills_graphify_skill_graphify_skill", "label": "graphify Skill", "file_type": "document", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_fast_path_existing_graph", "label": "Fast Path: Query Existing Graph", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json exists and the request is a natural-language question, skip Steps 1-5 and run graphify query directly."}, {"id": "plugins_shared_graphify_skills_graphify_skill_when_to_build_graph", "label": "When a Graph Is Worth Building", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic extraction costs minutes and tens of thousands of tokens; a single targeted lookup is cheaper with grep. Build for many questions, large/unfamiliar corpora, doc-to-code links, or structural questions."}, {"id": "plugins_shared_graphify_skills_graphify_skill_interpreter_detection", "label": "Interpreter Detection (.graphify_python)", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves uv tool, pipx shebang or python3; scan root passed via quoted heredoc so a malicious path cannot execute as shell code."}, {"id": "plugins_shared_graphify_skills_graphify_skill_detect_files", "label": "Step 2 Detect Files", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_ast_extraction", "label": "Part A Structural (AST) Extraction", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_semantic_extraction", "label": "Part B Semantic Extraction Subagents", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must use general-purpose subagents dispatched in one message; Explore is read-only and silently drops chunk files."}, {"id": "plugins_shared_graphify_skills_graphify_skill_no_api_key_rule", "label": "No API Key Required", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AST needs no LLM; semantic extraction uses Gemini only if GEMINI_API_KEY/GOOGLE_API_KEY is set, otherwise the host agent is the LLM. Never prompt for ANTHROPIC_API_KEY."}, {"id": "plugins_shared_graphify_skills_graphify_skill_semantic_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "check_semantic_cache/save_semantic_cache keyed by SPEC_PATH so a changed extraction prompt invalidates old entries (#1939); partial files are cached as misses."}, {"id": "plugins_shared_graphify_skills_graphify_skill_chunk_splitting", "label": "Chunk Splitting Bounds", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At most 20-25 files and ~6000 lines per chunk; >2000-line files get their own chunk; images get their own chunk; bounding content keeps coverage honest (#2225)."}, {"id": "plugins_shared_graphify_skills_graphify_skill_coverage_verification", "label": "Step B3.5 Coverage Verification", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A well-formed chunk is not evidence of coverage; self-reported line counts are compared to real file length and short files are cached as partial and retried."}, {"id": "plugins_shared_graphify_skills_graphify_skill_merge_ast_semantic", "label": "Part C Merge AST + Semantic", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stamps _origin semantic so a doc node with an L<line> source_location is not mistaken for AST tier and deleted on update (#2843)."}, {"id": "plugins_shared_graphify_skills_graphify_skill_build_cluster_analyze", "label": "Step 4 Build, Cluster, Analyze", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_shrink_guard", "label": "graph.json Shrink Guard (#479)", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write a smaller graph than the existing one; report and analysis sidecar are written only if graph.json was written."}, {"id": "plugins_shared_graphify_skills_graphify_skill_graph_health_check", "label": "Step 4.5 Graph Health Check", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_label_communities", "label": "Step 5 Label Communities", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_manifest_and_cost_tracker", "label": "Step 9 Manifest and Cost Tracker", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files that produced output are stamped (#2015); partial files stay unstamped (#2225) so the next --update re-queues them."}, {"id": "plugins_shared_graphify_skills_graphify_skill_graph_report", "label": "GRAPH_REPORT.md", "file_type": "concept", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_shared_graphify_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent edges (use AMBIGUOUS), never skip corpus warning, always show token cost and raw cohesion, warn before HTML viz over 5000 nodes."}], "edges": [{"source": "plugins_shared_graphify_skills_graphify_skill_graphify_skill", "target": "plugins_shared_graphify_skills_graphify_skill_fast_path_existing_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_shared_graphify_skills_graphify_skill_graphify_skill", "target": "plugins_shared_graphify_skills_graphify_skill_when_to_build_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_shared_graphify_skills_graphify_skill_fast_path_existing_graph", "target": "plugins_shared_graphify_skills_graphify_references_query_bfs_dfs_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_shared_graphify_skills_graphify_skill_graphify_skill", "target": "plugins_shared_graphify_skills_graphify_references_github_and_merge_graphify_clone", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_shared_graphify_skills_graphify_skill_interpreter_detection", "target": "plugins_shared_graphify_skills_graphify_skill_detect_files", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_shared_graphify_skills_graphify_skill_detect_files", "target": "plugins_shared_graphify_skills_graphify_references_transcribe_whisper_transcription", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/shared/graphify/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "plugins_shared_graphify_skills_