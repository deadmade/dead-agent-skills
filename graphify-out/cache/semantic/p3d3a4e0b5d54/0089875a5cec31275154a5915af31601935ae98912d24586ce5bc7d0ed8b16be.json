{"nodes": [{"id": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_glossary_format", "label": "GLOSSARY.md Format", "file_type": "document", "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_glossary_md", "label": "GLOSSARY.md (canonical teaching language)", "file_type": "concept", "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compressing a concept into a tight definition is evidence of understanding, so building the glossary is itself learning."}, {"id": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_be_opinionated_aliases", "label": "Opinionated terms with aliases to avoid", "file_type": "rationale", "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When several words exist for one concept, pick the best and list the rest under _Avoid_; this is how language compresses."}, {"id": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_add_term_only_when_understood", "label": "Add a term only when the user understands it", "file_type": "rationale", "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The glossary is a record of compressed knowledge, not a dictionary to learn from."}], "edges": [{"source": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_glossary_format", "target": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_glossary_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "weight": 1.0}, {"source": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_glossary_format", "target": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_be_opinionated_aliases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "weight": 1.0}, {"source": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_glossary_format", "target": "plugins_flows_packs_mattpocock_picks_skills_teach_glossary_format_add_term_only_when_understood", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/flows/packs/mattpocock-picks/skills/teach/GLOSSARY-FORMAT.md", "source_location": null, "weight": 1.0}], "hyperedges": []}