{"nodes": [{"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_atelier", "label": "Atelier theme", "file_type": "document", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editorial restrained theme: a maker's catalogue in still air on limewash paper; not a cream page with a thin luxury serif, not a product page with a blue button."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_luminous_air_field", "label": "Luminous air WebGL field", "file_type": "rationale", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One fixed WebGL domain-warped noise field drifting in cream and amber veils behind the page; pointer path parts it; still frame fallback; never a gradient blob."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_cotton_card_stock", "label": "Cotton card stock", "file_type": "concept", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Card stock with fibre, lit top-left edge, inner hairline frame and pressed type; never a flat white card or blurred glass."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_sample_strips", "label": "Sample strips (blotters)", "file_type": "concept", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slim cotton blotters with stain wicking from the tip, fanned from a rivet or hung from a rail as tabs."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_letterpress_booking_card", "label": "Letterpress booking card", "file_type": "concept", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The booking form as a letterpress card with ringed day picker and engraved time chips."}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_font_sentient", "label": "Sentient (typeface)", "file_type": "concept", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_font_hanken_grotesk", "label": "Hanken Grotesk (typeface)", "file_type": "concept", "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_atelier", "target": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_luminous_air_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "weight": 1.0}, {"source": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_atelier", "target": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_cotton_card_stock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/hallmark/skills/hallmark/references/themes/atelier.md", "source_location": null, "weight": 1.0}, {"source": "plugins_opt_in_hallmark_skills_hallmark_references_themes_atelier_atelie