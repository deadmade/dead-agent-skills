{"nodes": [{"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing", "label": "Indexing Reference (PostgreSQL)", "file_type": "document", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_btree_index", "label": "B-tree Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default choice for equality and range queries on scalar types."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_gin_index", "label": "GIN Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Larger and slower to update than B-tree but excels at multi-valued containment (JSONB, arrays, FTS, trigram)."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_jsonb_path_ops", "label": "jsonb_path_ops Operator Class", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2-3x smaller than jsonb_ops but only supports @> containment."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_gist_index", "label": "GiST Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_brin_index", "label": "BRIN Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~0.1% of B-tree size; effective only when physical row order correlates with column value."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_hash_index", "label": "Hash Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only supports =; rarely better than B-tree."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_composite_index_column_ordering", "label": "Composite Index Column Ordering", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equality columns first, then range/sort columns, because the index is a sorted tree leftmost column first."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_btree_skip_scan_pg18", "label": "B-tree Skip Scan (PG18+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets (a,b,c) serve queries on b or c alone by scanning each distinct a; best with low-cardinality leading column."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_partial_index", "label": "Partial Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smaller index means faster lookups and less maintenance; query WHERE must imply the predicate."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_covering_index_include", "label": "Covering Index (INCLUDE)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enables index-only scans without bloating the B-tree structure or affecting uniqueness."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_expression_index", "label": "Expression Index", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_partitioned_table_indexes", "label": "Indexes on Partitioned Tables", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique/PK indexes must include all partition key columns; CONCURRENTLY requires ON ONLY parent + per-partition build + ATTACH."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_create_index_concurrently", "label": "CREATE INDEX CONCURRENTLY", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L230", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids locking writes in production; two table scans, cannot run in a transaction, leaves INVALID index on failure."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_reindex_concurrently", "label": "REINDEX CONCURRENTLY", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_unused_index_query", "label": "Finding Unused Indexes", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L268", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_duplicate_index_query", "label": "Finding Duplicate Indexes", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L286", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_index_selection_decision_tree", "label": "Index Selection Decision Tree", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L302", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pick index by operator, selectivity (>10-20% favors seq scan), narrowing, index-only needs, and expressions."}], "edges": [{"source": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing", "target": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_btree_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L14", "weight": 1.0}, {"source": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing", "target": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_gin_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L24", "weight": 1.0}, {"source": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing", "target": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_jsonb_path_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/indexing.md", "source_location": "L47", "weight": 1.0}, {"source": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing", "target": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_indexing_gist_index", "r