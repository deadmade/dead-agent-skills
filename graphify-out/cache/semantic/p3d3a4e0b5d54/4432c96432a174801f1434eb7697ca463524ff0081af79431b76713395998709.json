{"nodes": [{"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design", "label": "Schema Design Reference", "file_type": "document", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_identity_columns", "label": "Identity Columns (GENERATED ALWAYS)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid serial/bigserial because of looser sequence ownership."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_uuidv7", "label": "UUIDv7 Primary Keys", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UUIDv4 fragments B-tree indexes; UUIDv7 is time-ordered and preserves insert locality."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_timestamptz", "label": "Use timestamptz", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamp loses timezone context."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_text_with_check", "label": "text with CHECK over varchar(n)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "varchar(n) offers no performance benefit and makes changes harder."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_unique_nulls_not_distinct", "label": "UNIQUE NULLS NOT DISTINCT (PG15+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_snake_case_naming", "label": "snake_case Naming Convention", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quoted mixed-case identifiers break ORMs, tools and AI assistants."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_enum_vs_check_vs_lookup", "label": "Enums vs Check Constraints vs Lookup Tables", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CHECK/ENUM for small stable sets; lookup table for evolving sets or metadata."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_foreign_key_actions", "label": "ON DELETE / ON UPDATE Actions", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_deferrable_foreign_keys", "label": "Deferrable Foreign Keys", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_index_fk_column", "label": "Index the FK Column", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL does not auto-index FK columns; without it JOINs and parent DELETEs scan the child table."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_exclusion_constraints", "label": "Exclusion Constraints (Prevent Overlaps)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_without_overlaps_pg18", "label": "Temporal Constraints WITHOUT OVERLAPS (PG18+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L171", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplifies the