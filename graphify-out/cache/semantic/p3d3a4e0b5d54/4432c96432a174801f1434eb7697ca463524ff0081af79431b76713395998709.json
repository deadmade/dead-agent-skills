": "DETACH PARTITION CONCURRENTLY (PG14+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L278", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_virtual_generated_columns", "label": "Virtual Generated Columns (PG18+)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L292", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Virtual saves storage and write I/O but cannot be indexed; use STORED when indexing."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_row_level_security", "label": "Row-Level Security for Multi-Tenancy", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L315", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_shared_schema_tenant_id", "label": "Shared Schema with tenant_id", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L327", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_schema_design_migration_safety", "label": "Migration Safety (Safe Column Operations)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/schema-design.md", "source_location": "L333"