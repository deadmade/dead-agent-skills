{"nodes": [{"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation", "label": "Transaction Isolation Reference", "file_type": "document", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_isolation_levels_overview", "label": "PostgreSQL Isolation Levels Overview", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_read_committed", "label": "READ COMMITTED", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default; fine for simple CRUD with atomic SQL - escalate only for a specific anomaly."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_lost_update_problem", "label": "Lost Update Problem", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-then-write patterns in READ COMMITTED silently overwrite concurrent updates."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_atomic_sql_update", "label": "Atomic SQL Update", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UPDATE re-evaluates the column from the latest committed row."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_select_for_update", "label": "SELECT FOR UPDATE Row Locking", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_update_reevaluation", "label": "UPDATE Re-evaluation in READ COMMITTED", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_repeatable_read", "label": "REPEATABLE READ", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single snapshot; raises serialization errors instead of silently re-evaluating."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_write_skew", "label": "Write Skew Anomaly", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not prevented by REPEATABLE READ; requires SERIALIZABLE."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_serializable_ssi", "label": "SERIALIZABLE (Serializable Snapshot Isolation)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimistic dependency tracking instead of heavy upfront locks; needs retry logic."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_serialization_failure_40001", "label": "Serialization Failure (SQLSTATE 40001)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected behavior, not a bug - applications must catch and retry."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_long_transaction_pitfall", "label": "Long Transactions Pitfall", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L243", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held snapshots block VACUUM and increase conflicts."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_mixing_isolation_levels", "label": "Mixing Isolation Levels Pitfall", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L252", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_choosing_isolation_level", "label": "Choosing the Right Isolation Level", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L260", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_application_retry_pattern", "label": "Application-Level Retry with Exponential Backoff and Jitter", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry the whole transaction, re-run reads, bound attempts, never publish side effects before commit."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation_transfer_funds_procedure", "label": "transfer_funds PL/pgSQL Procedure", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-best-practices/references/transaction-isolation.md", "source_location": "L318", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PL/pgSQL EXCEPTION blocks only roll back a subtransaction, so the application must own the retry loop."}], "edges": [{"source": "plugins_opt_in_implementation_postgres_skills_postgres_best_practices_references_transaction_isolation", "target": "plugins_opt_in_imp