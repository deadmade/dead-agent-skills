{"nodes": [{"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill", "label": "postgres-database-migration Skill", "file_type": "document", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_ddl_lock_reference", "label": "DDL Lock Reference", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The critical question is whether a change blocks reads/writes and for how long."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_access_exclusive_lock_queue", "label": "AccessExclusiveLock Queueing", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even a fast DDL waits for in-flight transactions and queues all later queries behind it."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_add_column_safely", "label": "Add a Column Safely", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Volatile defaults force a full rewrite; add nullable, backfill, then set default + NOT NULL."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_drop_column_safely", "label": "Drop a Column Safely", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deploy code that stops using the column first; DROP COLUMN does not physically delete data."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_column_swap_pattern", "label": "Column-Swap Pattern", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-downtime alternative to RENAME COLUMN and ALTER COLUMN TYPE."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_change_column_type", "label": "Change a Column Type", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most type changes rewrite the table; use new column + backfill + swap."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_add_not_null_constraint", "label": "Add a NOT NULL Constraint (CHECK NOT VALID / PG18 NOT VALID)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_add_foreign_key_not_valid", "label": "Add a Foreign Key (NOT VALID + VALIDATE)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_create_index_concurrently", "label": "Add an Index Concurrently", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain CREATE INDEX blocks writes; failed concurrent builds leave INVALID indexes."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_unique_constraint_using_index", "label": "Add a Unique Constraint USING INDEX", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L207", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_redefine_primary_key", "label": "Redefine a Primary Key", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses a concurrently built unique index and a validated CHECK so PRIMARY KEY USING INDEX is instant."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_rollback_planning", "label": "Rollback Planning", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Document a rollback before execution; irreversible ops need a backup or fork."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_transaction_strategy", "label": "Transaction Strategy (Wrapped vs Separate)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L293", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single transaction gives atomicity but holds all locks until COMMIT; separate transactions release locks but can leave partial state."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_lock_timeout", "label": "lock_timeout", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L349", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it one slow query can cascade into an application-wide outage."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_statement_timeout", "label": "statement_timeout", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L351", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safety net against unexpected rewrites; avoid on known-slow concurrent index builds."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_retry_with_timeout_pattern", "label": "Retry-With-Timeout Pattern", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L388", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each attempt either succeeds quickly or gives up so traffic flows."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_lock_nowait", "label": "LOCK TABLE ... NOWAIT", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L422", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fails instantly without entering the lock queue - zero cascading risk but more retries."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_fork_based_migration_testing", "label": "Fork-Based Migration Testing", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L433", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests against real data/edge cases; does not catch concurrent-traffic issues."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_neon", "label": "Neon", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L435", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_pgdog_mirroring", "label": "PgDog Mirroring", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L452", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replays production traffic against the fork for very high-uptime applications."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_subtrans_slru_contention", "label": "SubtransSLRU Contention from PL/pgSQL Retry Loops", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L476", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move retry logic to the application layer if replica lag appears."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_autovacuum_blocks_validate", "label": "Autovacuum Wraparound Blocking VALIDATE CONSTRAINT", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L478", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not cancel wraparound-prevention autovacuum - risk of data loss."}, {"id": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_migration_common_pitfalls", "label": "Migration Common Pitfalls", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L480", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill", "target": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_ddl_lock_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L29", "weight": 1.0}, {"source": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill", "target": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill_access_exclusive_lock_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plugins/opt-in/implementation/postgres/skills/postgres-database-migration/SKILL.md", "source_location": "L65", "weight": 1.0}, {"source": "plugins_opt_in_implementation_postgres_skills_postgres_database_migration_skill", "target": "plugins_opt_in_implementation_postgres_skill