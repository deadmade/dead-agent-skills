{"nodes": [{"id": "plugins_opt_in_implementation_csharp_skills_library_csharp_refactoring_skill_doc", "label": "C# Refactoring skill (behavior-preserving)", "file_type": "document", "source_file": "plugins/opt-in/implementation/csharp-skills/library/csharp-refactoring/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_csharp_refactoring_skill_classification_gate", "label": "Mandatory classification gate (classify before editing)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/csharp-refactoring/SKILL.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classify each requested operation before restoring/building/editing so behavior-changing work (upgrades, features, contract changes) is separated or declined instead of being smuggled into a refactor."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_csharp_refactoring_skill_whole_request_stop_response", "label": "Whole-request stop response (Not a behavior-preserving refactor / No files changed / Next workflow)", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/csharp-refactoring/SKILL.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_csharp_refactoring_skill_workspace_boundary", "label": "Work only in the current workspace boundary", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/csharp-refactoring/SKILL.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never search outside the repo root or pick a similarly named clone/worktree; report missing paths rather than guessing."}, {"id": "plug