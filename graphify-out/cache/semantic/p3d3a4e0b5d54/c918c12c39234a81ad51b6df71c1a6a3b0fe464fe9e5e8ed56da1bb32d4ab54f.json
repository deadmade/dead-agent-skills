{"nodes": [{"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_dotnet_pinvoke", "label": "dotnet-pinvoke skill", "file_type": "document", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_dllimport", "label": "DllImport", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_libraryimport", "label": "LibraryImport (source-generated)", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compile-time source generation makes it AOT- and trim-safe; prefer for new .NET 7+ code and the only option under native AOT."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_clong", "label": "CLong / CULong for C long", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C long is 32-bit on Windows and 64-bit on 64-bit Unix, so int or long is wrong on one platform."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_disableruntimemarshalling", "label": "[assembly: DisableRuntimeMarshalling]", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_safehandle", "label": "SafeHandle for native handles", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw IntPtr leaks on exceptions and has no double-free protection; SafeHandle is non-negotiable."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_memory_ownership_models", "label": "Memory ownership models", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one side must own cross-boundary memory and free it with the matching allocator; mismatched free (FreeHGlobal on malloc'd memory) is heap corruption."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_explicit_string_encoding", "label": "Explicit string encoding", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no safe default; call W (UTF-16) Win32 variants, expect UTF-8 for cross-platform C, never rely on CharSet.Auto or StringBuilder buffers."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_unmanagedcallersonly", "label": "UnmanagedCallersOnly callbacks", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred on .NET 8+: avoids delegates entirely, so there is no GC lifetime risk."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_delegate_rooting", "label": "Delegate rooting and GC.KeepAlive", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A collected callback delegate crashes native code; function pointers from GetFunctionPointerForDelegate do not root the delegate."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_setlasterror", "label": "SetLastError / Marshal.GetLastPInvokeError", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_nativelibrary_setdllimportresolver", "label": "Cross-platform library loading (NativeLibrary.SetDllImportResolver)", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_dllimport_to_libraryimport_migration", "label": "DllImport to LibraryImport migration", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only migrate when the user asks or AOT/trimming is a requirement; fix SYSLIB1054-SYSLIB1057 analyzer warnings."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_windows_x86_calling_convention", "label": "Explicit calling convention on Windows x86", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cdecl and StdCall differ only on Windows x86; on x64/ARM/ARM64 the attribute is unnecessary."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_trust_native_header", "label": "Trust the native header over documentation", "file_type": "rationale", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Online docs, including official Win32 docs, often simplify types, calling conventions and struct layout."}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_cswin32", "label": "Microsoft.Windows.CsWin32", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_cswinrt", "label": "Microsoft.Windows.CsWinRT", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_library_dotnet_pinvoke_skill_objective_sharpie", "label": "Objective Sharpie", "file_type": "concept", "source_file": "plugins/opt-in/implementation/csharp-skills/library/dotnet-pinvoke/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plugins_opt_in_implementation_csharp_skills_li